{
  "name": "dsh-agents-md",
  "version": "1.0.0",
  "type": "module",
  "description": "Installs the author's global working instructions as $DSH_HOME/AGENTS.md so every DeepSeek Harness session in every project loads them; an existing file is kept unless overwrite is enabled.",
  "license": "MIT",
  "author": "Maxim Fedorov (Winkerok) <https://github.com/MaximFedorovtoo>",
  "homepage": "https://github.com/MaximFedorovtoo/dsh-plugins/tree/main/plugins/dsh-agents-md",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MaximFedorovtoo/dsh-plugins.git",
    "directory": "plugins/dsh-agents-md"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "agents-md",
    "instructions",
    "workflow"
  ],
  "engines": {
    "dsh": ">=0.2.0 <0.3.0"
  },
  "exports": {
    ".": "./index.js",
    "./instructions": "./AGENTS.md",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "AGENTS.md",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "README.ru.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
