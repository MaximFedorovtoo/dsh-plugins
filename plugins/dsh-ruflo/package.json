{
  "name": "dsh-ruflo",
  "version": "0.5.2",
  "type": "module",
  "description": "Ruflo for DSH: project- or chat-scoped memory, tasks and swarms, DeepSeek-native init, /ruflo composer command and a DeepSeek-only executor whose API key is entered in the plugin settings page.",
  "license": "MIT",
  "author": "Maxim Fedorov (Winkerok) <https://github.com/MaximFedorovtoo>",
  "homepage": "https://github.com/MaximFedorovtoo/dsh-plugins/tree/main/plugins/dsh-ruflo",
  "repository": { "type": "git", "url": "git+https://github.com/MaximFedorovtoo/dsh-plugins.git", "directory": "plugins/dsh-ruflo" },
  "keywords": ["dsh","dsh-plugin","deepseek-harness","ruflo","deepseek","agent-memory","swarm","tasks","orchestration","executor"],
  "engines": { "dsh": ">=0.2.0 <0.3.0" },
  "icon": "./icon.svg",
  "exports": { ".": "./index.js", "./client": "./client.js", "./locale/*.json": "./locale/*.json", "./icon": "./icon.svg" },
  "files": ["index.js","client.js","agent-execute.mjs","cordis.patch.yml","locale/*.json","icon.svg","README.md","README.ru.md","INSTALL.md","INSTALL.en.md"],
  "dependencies": { "ruflo": "^3.68.0" },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-locale","@deepseek-ai/dsh-client-ui-commands","@deepseek-ai/dsh-client-ui-conversation","@deepseek-ai/dsh-client-ui-plugin-manager"]
    }
  }
}