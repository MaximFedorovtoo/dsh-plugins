{
  "name": "dsh-ruflo",
  "version": "0.4.0",
  "type": "module",
  "description": "Ruflo for DSH: project- or chat-scoped memory, tasks and swarms from the ruvnet/ruflo CLI, DeepSeek-native init (AGENTS.md, no Claude Code artifacts) and a DeepSeek executor bridge that runs Ruflo tasks through DSH subagents.",
  "license": "MIT",
  "author": "Maxim Fedorov (Winkerok) <https://github.com/MaximFedorovtoo>",
  "homepage": "https://github.com/MaximFedorovtoo/dsh-plugins/tree/main/plugins/dsh-ruflo",
  "repository": { "type": "git", "url": "git+https://github.com/MaximFedorovtoo/dsh-plugins.git", "directory": "plugins/dsh-ruflo" },
  "keywords": ["dsh","dsh-plugin","deepseek-harness","ruflo","claude-flow","agent-memory","swarm","tasks","hooks","orchestration","executor"],
  "engines": { "dsh": ">=0.2.0 <0.3.0" },
  "icon": "./icon.svg",
  "exports": { ".": "./index.js", "./client": "./client.js", "./locale/*.json": "./locale/*.json", "./icon": "./icon.svg" },
  "files": ["index.js","client.js","cordis.patch.yml","locale/*.json","icon.svg","README.md","README.ru.md","INSTALL.md","INSTALL.en.md"],
  "dependencies": { "ruflo": "^3.68.0" },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": { "platform": "web", "immediately": true, "inject": ["@deepseek-ai/dsh-client-locale","@deepseek-ai/dsh-client-ui-commands","@deepseek-ai/dsh-client-ui-conversation"] }
  }
}