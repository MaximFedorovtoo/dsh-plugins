{
  "name": "dsh-ruflo",
  "version": "0.1.0",
  "type": "module",
  "description": "Ruflo for DSH: project- or chat-scoped agent memory, tasks, swarms, agents and self-learning hooks from the ruvnet/ruflo CLI, exposed as native tools.",
  "license": "MIT",
  "author": "Maxim Fedorov (Winkerok) <https://github.com/MaximFedorovtoo>",
  "homepage": "https://github.com/MaximFedorovtoo/dsh-plugins/tree/main/plugins/dsh-ruflo",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MaximFedorovtoo/dsh-plugins.git",
    "directory": "plugins/dsh-ruflo"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "ruflo",
    "claude-flow",
    "agent-memory",
    "swarm",
    "tasks",
    "hooks",
    "orchestration"
  ],
  "engines": {
    "dsh": ">=0.2.0 <0.3.0"
  },
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.ru.md",
    "INSTALL.md",
    "INSTALL.en.md"
  ],
  "dependencies": {
    "ruflo": "^3.68.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}