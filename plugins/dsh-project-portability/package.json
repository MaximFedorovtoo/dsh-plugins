{
  "name": "dsh-project-portability",
  "version": "1.0.0",
  "type": "module",
  "description": "Portable DSH projects: export a workspace with all of its files, chats and context into one .dshpack archive, carry it on an external drive, and import it on another computer so work continues in the same chats.",
  "license": "MIT",
  "author": "Maxim Fedorov (Winkerok) <https://github.com/MaximFedorovtoo>",
  "homepage": "https://github.com/MaximFedorovtoo/dsh-plugins/tree/main/plugins/dsh-project-portability",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MaximFedorovtoo/dsh-plugins.git",
    "directory": "plugins/dsh-project-portability"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "portable",
    "backup",
    "transfer",
    "export",
    "import",
    "archive"
  ],
  "engines": {
    "dsh": ">=0.2.0 <0.3.0"
  },
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/*.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.ru.md",
    "INSTALL.md",
    "INSTALL.en.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  }
}
