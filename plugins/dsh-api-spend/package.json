{
  "name": "dsh-api-spend",
  "version": "1.1.0",
  "type": "module",
  "description": "API spend per project at the provider's official rates, shown below the composer beside the token counters, with a per-project breakdown and the platform's own totals.",
  "license": "MIT",
  "author": "Maxim Fedorov (Winkerok) <https://github.com/MaximFedorovtoo>",
  "homepage": "https://github.com/MaximFedorovtoo/dsh-plugins/tree/main/plugins/dsh-api-spend",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MaximFedorovtoo/dsh-plugins.git",
    "directory": "plugins/dsh-api-spend"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "usage",
    "cost",
    "spend",
    "tokens",
    "billing"
  ],
  "engines": {
    "dsh": ">=0.2.0 <0.3.0"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./aggregate": "./aggregate.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "aggregate.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.ru.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
