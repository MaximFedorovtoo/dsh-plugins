{
  "name": "dsh-unslop",
  "version": "0.1.0",
  "type": "module",
  "description": "De-AI writing for DSH agents: vendored theclaymethod/unslop scanners, fact-preservation gates, suggestion checks and an LLM rewrite that removes AI tells without changing meaning.",
  "license": "MIT",
  "author": "Maxim Fedorov (Winkerok) <https://github.com/MaximFedorovtoo>",
  "homepage": "https://github.com/MaximFedorovtoo/dsh-plugins/tree/main/plugins/dsh-unslop",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MaximFedorovtoo/dsh-plugins.git",
    "directory": "plugins/dsh-unslop"
  },
  "keywords": ["dsh", "dsh-plugin", "deepseek-harness", "unslop", "writing", "editing", "ai-detection", "de-slop", "text"],
  "engines": {
    "dsh": ">=0.2.0 <0.3.0"
  },
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.ru.md",
    "INSTALL.md",
    "INSTALL.en.md",
    "python/SKILL.md",
    "python/scripts/*",
    "python/evals/**/*"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}